+/* A picture rate a fixed-refresh screen of `screen_hz` shows evenly - one of
+   its whole fractions (screen / k, k 1 to 4), every picture on screen for the
+   same number of refreshes - for one asked of `asked_hz`: the asked itself
+   when it is one (within 1%), else the nearest such fraction between
+   `least_hz` and `most_hz`, the lower of two as near; above the asked only
+   when within half again of it (a 144 Hz screen's 144 for 120: none below 90;
+   a 360 Hz screen's 120 is a fraction). 0: none, or the screen's not known.
+   120 a second free-running against a 144 Hz screen showed one picture in
+   five for two refreshes - 24 a second, a judder no pacing could undo. */
+inline double EvenRate(double asked_hz, double screen_hz, double least_hz, double most_hz) {
+    if (!(screen_hz > 0) || !(asked_hz > 0)) return 0.0;
+    double best = 0.0;
+    for (int k = 1; k <= 4; ++k) {
+        const double rate = screen_hz / k;
+        if (std::fabs(rate - asked_hz) <= 0.01 * asked_hz) return rate;
+        if (rate < least_hz - 1e-9 || rate > most_hz + 1e-9) continue;
+        if (rate > asked_hz * 1.5) continue;
+        if (best == 0.0 || std::fabs(rate - asked_hz) < std::fabs(best - asked_hz) - 1e-9 ||
+            (std::fabs(std::fabs(rate - asked_hz) - std::fabs(best - asked_hz)) <= 1e-9 && rate < best))
+            best = rate;
+    }
+    return best;
+}
+
+/* The highest of a fixed-refresh screen's whole fractions (screen / k, k 1
+   to 4) below `rate_hz` (by more than a hertz) and at `least_hz` or more: the
+   step down from a rate the machine did not keep up with that the screen
+   still shows evenly. 0: none (a 144 Hz screen below 144: 72 is under 90). */
+inline double EvenRateBelow(double rate_hz, double screen_hz, double least_hz) {
+    if (!(screen_hz > 0)) return 0.0;
+    for (int k = 1; k <= 4; ++k) {
+        const double rate = screen_hz / k;
+        if (rate < rate_hz - 1.0 && rate >= least_hz - 1e-9) return rate;
+    }
+    return 0.0;
+}
+
